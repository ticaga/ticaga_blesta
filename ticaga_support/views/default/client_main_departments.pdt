<?php
            // Don't show this container when only rendering the widget section
            if (!(isset($render_section) ? $render_section : null)) {
            ?>
        <div class="col-md-12">
            <?php
            }
            echo (isset($message) ? $message : null);

            if (isset($unlinked_notice) && $unlinked_notice) {
            ?>
            <div class="alert alert-warning">
                Your support account isn't linked to Ticaga yet, so any ticket you open here is created as a guest and won't appear in your account's ticket history until it's linked.
                Your account will be linked automatically shortly, or you can <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/ticaga_support/client_main/sync/');?>">link it now</a>.
            </div>
            <?php
            }

            $this->WidgetClient->clear();
            $this->WidgetClient->setStyleSheet($this->view_dir . 'css/styles.css', ['id' => 'ticaga_support_styles']);
            $this->WidgetClient->create($this->_('ClientTickets.index.boxtitle_tickets', true), ['id'=>'client_tickets'], (isset($render_section) ? $render_section : null));
            $this->WidgetClient->startBody();
            ?>
            <div class="row">
                <?php
                if (!empty($depts)) {
                    $i = 0;
                    foreach ((isset($depts) ? $depts : []) as $department) {
                    ?>
                <div class="col-md-6">
                    <div class="list-group mb-3">
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/ticaga_support/client_main/open/' . (isset($department['slug']) ? $department['slug'] : null) . '/');?>" class="list-group-item p-3">
                            <h4 class="border-0 pb-0"><?php echo (isset($department['department_name']) ? $this->Html->safe($department['department_name']) : null);?></h4>
                            <?php
                            if (!empty($department['department_description'])) {
                                echo $this->Html->safe($department['department_description']);
                            }
                            ?>
                        </a>
                    </div>
                </div>
                    <?php
                    }
                    unset($i);
                } else {
                ?>
                <div class="col-md-12">
                    <div class="alert alert-info">
                        <p><?php $this->_('ClientTickets.!notice.no_departments');?></p>
                    </div>
                </div>
                <?php
                }
                ?>
            </div>
            <?php
            $this->WidgetClient->endBody();
            $this->WidgetClient->end();

            // Don't show this container when only rendering the widget section
            if (!(isset($render_section) ? $render_section : null)) {
            ?>
        </div>
        <?php
		    }
	    ?>