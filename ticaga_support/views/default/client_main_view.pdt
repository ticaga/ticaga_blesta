        <div class="tk-meta-info">
            <div class="tk-meta-item">
                <span class="tk-meta-label"><?php echo $this->_('TicagaSupportPlugin.index.department', true); ?></span>
                <span class="tk-meta-value"><?php echo ucwords($this->Html->safe(isset($ticket->department_name) ? $ticket->department_name : '-')); ?></span>
            </div>
            <div class="tk-meta-item">
                <span class="tk-meta-label"><?php echo $this->_('TicagaSupportPlugin.index.priority', true); ?></span>
