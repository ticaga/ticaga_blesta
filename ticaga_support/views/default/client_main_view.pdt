            </div>
            <div class="tk-meta-item">
                <span class="tk-meta-label"><?php echo $this->_('TicagaSupportPlugin.index.status', true); ?></span>
                <span class="tk-meta-value"><span class="tk-badge <?php echo $status_class; ?>"><?php echo $this->Html->safe($status_label); ?></span></span>
            </div>
            <div class="tk-meta-item">
                <span class="tk-meta-label"><?php echo $this->_('TicagaSupportPlugin.index.date_opened', true); ?></span>
                <span class="tk-meta-value"><?php echo $this->Html->safe(date('jS F Y H:i', strtotime($ticket->ticket_created))); ?></span>
            </div>
        </div>
        <?php
            // Star rating sits in the meta bar's right side (fills the space)
            if (!empty($ratings_enabled)) {
                $current_rating = (int) (isset($ticket->rating) ? $ticket->rating : 0);
        ?>
        <div class="tk-meta-rating">
            <span class="tk-meta-label"><?php echo $this->_('TicagaSupportPlugin.index.rate_ticket', true); ?></span>
            <?php $this->Form->create(null, ['class' => 'tk-rating', 'data-current' => $current_rating]); ?>
                <span class="tk-stars">
                    <?php for ($i = 5; $i >= 1; $i--) { ?>
                        <button type="submit" name="rating" value="<?php echo $i; ?>"
                            class="tk-star<?php echo ($i <= $current_rating) ? ' tk-star-on' : ''; ?>"
                            title="<?php echo $i; ?>" aria-label="<?php echo $i; ?>">&#9733;</button>
                    <?php } ?>
                </span>
            <?php $this->Form->end(); ?>
        </div>
        <?php } ?>
    </div>

    <?php
        // ----- Custom fields ------------------------------------------------
        $cf_list = isset($custom_fields) ? (array) $custom_fields : [];
        if (!empty($cf_list)) {
    ?>
    <div class="tk-card tk-custom-fields">
        <div class="tk-card-title"><?php echo $this->_('TicagaSupportPlugin.index.custom_fields', true); ?></div>
        <dl class="tk-cf-grid">
            <?php foreach ($cf_list as $cf) { ?>
                <dt><?php echo $this->Html->safe(isset($cf->name) ? $cf->name : ''); ?></dt>
                <dd>
                    <?php
                        if (!empty($cf->is_encrypted)) {
                            echo '<span class="tk-cf-hidden">' . $this->_('TicagaSupportPlugin.index.cf_hidden', true) . '</span>';
                        } else {
                            $val = isset($cf->value) ? $cf->value : '';
                            if (is_array($val)) {
                                $val = implode(', ', $val);
                            }
                            echo ($val === '' || $val === null)
                                ? '<span class="tk-cf-empty">&mdash;</span>'
                                : nl2br($this->Html->safe($val));
                        }
                    ?>
                </dd>
            <?php } ?>
        </dl>
    </div>
    <?php } ?>

    <!-- Original message -->
    <?php
        $opener_name = $ticket->name ?: $ticket->public_name;
    ?>
    <div class="tk-msg">
        <div class="tk-msg-head">
            <?php echo $tk_avatar($opener_name, false); ?>
            <div class="tk-msg-author">
                <span class="tk-msg-name"><?php echo $this->Html->safe($opener_name); ?></span>
                <span class="tk-badge tk-badge-customer"><?php echo $this->_('TicagaSupportPlugin.index.role_you', true); ?></span>
            </div>
            <span class="tk-msg-time"><?php echo $this->Html->safe(date('jS F Y H:i', strtotime($ticket->ticket_created))); ?></span>
        </div>
        <div class="tk-msg-body"><?php echo nl2br($this->Html->safe($ticket->message)); ?></div>
    </div>

    <!-- Replies (refreshed in place on live updates) -->
    <div id="tk-replies">
    <?php
        if (isset($replies) && !empty($replies)) {
            foreach ($replies as $reply) {
                foreach ($reply as $response) {
                    if ($response['is_note'] != '1') {
                        $is_staff = ($response['employee_response'] == '1');
    ?>
    <div class="tk-msg<?php echo $is_staff ? ' tk-msg-staff' : ''; ?>">
        <div class="tk-msg-head">
            <?php echo $tk_avatar($response['user_name'], $is_staff); ?>
            <div class="tk-msg-author">
                <span class="tk-msg-name"><?php echo $this->Html->safe($response['user_name']); ?></span>
                <?php if ($is_staff) { ?>
                    <span class="tk-badge tk-badge-staff"><?php echo $this->_('TicagaSupportPlugin.index.role_employee', true); ?></span>
                <?php } else { ?>
                    <span class="tk-badge tk-badge-customer"><?php echo $this->_('TicagaSupportPlugin.index.role_you', true); ?></span>
                <?php } ?>
            </div>
            <span class="tk-msg-time"><?php echo $this->Html->safe(date('jS F Y H:i', strtotime($response['created_at']))); ?></span>
        </div>
        <div class="tk-msg-body"><?php echo nl2br($this->Html->safe($response['content'])); ?></div>
    </div>
    <?php
                    }
                }
            }
        }
    ?>
    </div><!-- /#tk-replies -->

    <!-- Reply box (hidden once the ticket is closed) -->
    <?php if ($status_raw === 'closed') { ?>
    <div class="tk-closed-banner tk-closed-ticket">
        <span class="tk-closed-icon">&#128274;</span>
        <div>
            <strong><?php echo $this->_('TicagaSupportPlugin.index.ticket_closed', true); ?></strong>
            <div class="tk-closed-msg"><?php echo $this->_('TicagaSupportPlugin.index.ticket_closed_msg', true); ?></div>
        </div>
    </div>
    <?php } else { ?>
    <div class="tk-card tk-reply">
        <div class="tk-card-title"><?php echo $this->_('TicagaSupportPlugin.index.submit_response', true); ?></div>
        <?php $this->Form->create(); ?>
            <div class="form-group">
                <?php
                    $this->Form->fieldTextarea('response_content', null, ['id' => 'response_content', 'rows' => 5, 'class' => 'form-control', 'data-markdown-editor' => '']);
                ?>
            </div>
            <div class="tk-reply-actions">
                <button type="submit" name="close_ticket" value="1" class="btn btn-outline-danger"
                    onclick="return confirm('<?php echo $this->Html->safe($this->_('TicagaSupportPlugin.index.close_confirm', true)); ?>');">
                    <?php echo $this->_('TicagaSupportPlugin.index.close_ticket_btn', true); ?>
                </button>
                <button type="submit" class="btn btn-light">
                    <?php echo $this->_('TicagaSupportPlugin.index.submit', true); ?>
                </button>
            </div>
        <?php $this->Form->end(); ?>
    </div>
    <?php } ?>

    <?php
        // ----- Live updates (Reverb) ----------------------------------------
        // When realtime is enabled and the ticket has a public hash, subscribe to
        // the ticket's public channel and refresh the replies in place whenever a
        // new reply is broadcast. The ping is content-free; the replies are
        // re-rendered from the authenticated page, so nothing leaks over the socket.
        if (!empty($realtime) && !empty($realtime['enabled']) && !empty($ticket->public_hash)) {
            $rt_event = $realtime['event'] ?? 'reply.created';
            $rt_channel = ($realtime['channel_prefix'] ?? 'ticket.') . $ticket->public_hash;
    ?>
    <script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
    <script>
    (function () {
        if (typeof Pusher === 'undefined') { return; }
        var refreshTimer = null;

        function refreshReplies() {
            fetch(window.location.href, { credentials: 'same-origin' })
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    var fresh = doc.getElementById('tk-replies');
                    var current = document.getElementById('tk-replies');
                    if (fresh && current && fresh.innerHTML !== current.innerHTML) {
                        current.innerHTML = fresh.innerHTML;
                    }
                })
                .catch(function () {});
        }

        try {
            var pusher = new Pusher(<?php echo json_encode($realtime['key']); ?>, {
                wsHost: <?php echo json_encode($realtime['host']); ?>,
                wsPort: <?php echo json_encode((int) $realtime['port']); ?>,
                wssPort: <?php echo json_encode((int) $realtime['port']); ?>,
                forceTLS: <?php echo (($realtime['scheme'] ?? 'https') === 'https') ? 'true' : 'false'; ?>,
                enabledTransports: ['ws', 'wss'],
                disableStats: true,
                cluster: ''
            });
            var channel = pusher.subscribe(<?php echo json_encode($rt_channel); ?>);
            channel.bind(<?php echo json_encode($rt_event); ?>, function () {
                clearTimeout(refreshTimer);
                refreshTimer = setTimeout(refreshReplies, 400);
            });
        } catch (e) { /* realtime unavailable; static view remains */ }
    })();
    </script>
    <?php } ?>

</div>
<?php
    $this->WidgetClient->endBody();
    $this->WidgetClient->end();

    // Close the outer container opened above (when not rendering only the widget)
    if (!(isset($render_section) ? $render_section : null)) {
?>
    </div>
<?php
    }
?>
