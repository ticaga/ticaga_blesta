<?php
    // Don't show this container when only rendering the widget section
    if (!(isset($render_section) ? $render_section : null)) {
?>
    <div class="col-md-12">
    <?php
    }
        echo (isset($message) ? $message : null);

        // Create widget
        $this->Widget->clear();
        $this->Widget->setStyleSheet($this->view_dir . "css/styles.css");

        // Prefer the human-readable ticket code (e.g. ABCD/12345); fall back to id
        $ticket_ref = !empty($ticket->ticket_code) ? $ticket->ticket_code : ('#' . $this->Html->safe($ticket->id));
        $ticket_title = $this->_('TicagaSupportPlugin.index.ticket', true) . ' ' . $ticket_ref
            . ' - ' . mb_strimwidth($this->Html->safe($ticket->subject), 0, 60, "...");

        $this->WidgetClient->create($ticket_title);
        $this->WidgetClient->startBody();

        // ----- Display helpers -------------------------------------------------
        // Map raw status to its human label and a contextual colour
        $status_raw = isset($ticket->status) ? $ticket->status : '';
        $status_label = isset($statuses[$status_raw]) ? $statuses[$status_raw] : ucwords(str_replace('_', ' ', $status_raw));
        $status_classes = [
            'open' => 'tk-badge-info',
            'awaiting_reply' => 'tk-badge-warning',
            'in_progress' => 'tk-badge-info',
            'on_hold' => 'tk-badge-muted',
            'closed' => 'tk-badge-muted',
        ];
        $status_class = isset($status_classes[$status_raw]) ? $status_classes[$status_raw] : 'tk-badge-info';

        // Priority colour
        $priority_raw = isset($ticket->priority) ? $ticket->priority : '';
        $priority_classes = [
            'emergency' => 'tk-badge-danger',
            'critical' => 'tk-badge-danger',
            'high' => 'tk-badge-danger',
            'medium' => 'tk-badge-warning',
            'low' => 'tk-badge-success',
        ];
        $priority_class = isset($priority_classes[$priority_raw]) ? $priority_classes[$priority_raw] : 'tk-badge-muted';

        // Builds a coloured avatar with the author's initials
        $tk_avatar = function ($name, $is_staff) {
            $name = trim((string) $name);
            $initials = '';
            foreach (preg_split('/\s+/', $name) as $part) {
                if ($part !== '') {
                    $initials .= mb_strtoupper(mb_substr($part, 0, 1));
                }
                if (mb_strlen($initials) >= 2) {
                    break;
                }
            }
            if ($initials === '') {
                $initials = '?';
            }
            $cls = $is_staff ? 'tk-avatar tk-avatar-staff' : 'tk-avatar';
            return '<div class="' . $cls . '">' . htmlspecialchars($initials, ENT_QUOTES, 'UTF-8') . '</div>';
        };
?>
<style>
/* Ticaga ticket view — inlined so styling is guaranteed regardless of how the
   client area loads external stylesheets (and immune to stale CSS caching). */
.tk-ticket { padding: 4px 2px 8px; }
.tk-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 24px; padding: 16px 18px; margin-bottom: 16px; background: #f8f9fb; border: 1px solid #e7e9ef; border-radius: 8px; }
.tk-meta-info { display: flex; flex-wrap: wrap; gap: 28px; align-items: flex-start; }
.tk-meta-item { display: flex; flex-direction: column; gap: 4px; }
.tk-meta-rating { display: flex; flex-direction: column; gap: 6px; align-items: flex-end; }
.tk-meta-rating .tk-meta-label { text-align: right; }
.tk-meta-rating .tk-rating { gap: 2px; }
.tk-meta-rating .tk-star { font-size: 22px; }
.tk-meta-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: #8a909d; }
.tk-meta-value { font-size: 14px; color: #2b303b; font-weight: 500; }
.tk-badge { display: inline-block; padding: 3px 9px; border-radius: 999px; font-size: 12px; font-weight: 600; line-height: 1.4; }
.tk-badge-info { background: #e7f0ff; color: #1f5fd1; }
.tk-badge-warning { background: #fff3da; color: #a96a00; }
.tk-badge-success { background: #e3f6e8; color: #1c7a3e; }
.tk-badge-danger { background: #fde6e6; color: #c1342d; }
.tk-badge-muted { background: #eceef2; color: #6b7280; }
.tk-badge-staff { background: #4f46e5; color: #fff; }
.tk-badge-customer { background: #fbbf24; color: #533f03; }
.tk-card { border: 1px solid #e7e9ef; border-radius: 8px; padding: 16px 18px; margin-bottom: 16px; background: #fff; }
.tk-card-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; color: #6b7280; margin-bottom: 12px; }
.tk-cf-grid { display: grid; grid-template-columns: minmax(140px, 220px) 1fr; gap: 8px 18px; margin: 0; }
.tk-cf-grid dt { font-weight: 600; color: #4b5563; margin: 0; }
.tk-cf-grid dd { margin: 0; color: #2b303b; word-break: break-word; }
.tk-cf-hidden { color: #9ca3af; font-style: italic; }
.tk-cf-empty { color: #c0c4cc; }
.tk-rating { display: flex; align-items: center; gap: 4px; }
.tk-stars { display: flex; flex-direction: row-reverse; justify-content: flex-end; }
.tk-star { background: none; border: none; padding: 0 2px; font-size: 30px; line-height: 1; cursor: pointer; color: #d6d9e0; transition: color .12s ease, transform .12s ease; }
.tk-star-on { color: #f5b301; }
.tk-stars:hover .tk-star { color: #d6d9e0; }
.tk-stars .tk-star:hover, .tk-stars .tk-star:hover ~ .tk-star { color: #f5b301; }
.tk-rating-hint { margin-left: 10px; font-size: 12px; color: #9ca3af; }
.tk-msg { border: 1px solid #e7e9ef; border-radius: 8px; padding: 14px 16px; margin-bottom: 12px; background: #fff; }
.tk-msg-staff { border-left: 3px solid #4f46e5; background: #f6f5ff; }
.tk-msg-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.tk-msg-author { display: flex; align-items: center; gap: 8px; min-width: 0; }
.tk-msg-name { font-weight: 700; color: #2b303b; }
.tk-msg-time { margin-left: auto; font-size: 12px; color: #9ca3af; white-space: nowrap; }
.tk-msg-body { color: #374151; line-height: 1.55; word-break: break-word; }
.tk-avatar { flex: 0 0 auto; width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; color: #fff; background: #f5b301; }
.tk-avatar-staff { background: #4f46e5; }
.tk-reply { margin-top: 4px; }
.tk-reply-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }
.tk-reply-actions .btn { min-width: 96px; }
.tk-closed-banner { display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px; margin-bottom: 16px; background: #fff6e6; border: 1px solid #f3d699; border-left: 4px solid #e0a106; border-radius: 8px; color: #7a5a00; }
.tk-closed-banner strong { color: #6b4e00; }
.tk-closed-icon { font-size: 20px; line-height: 1.3; }
.tk-closed-msg { margin-top: 2px; font-size: 13px; color: #8a6d1f; }
.tk-closed-ticket { background: #f3f4f6; border-color: #e0e2e8; border-left-color: #9ca3af; color: #4b5563; }
.tk-closed-ticket strong { color: #374151; }
.tk-closed-ticket .tk-closed-msg { color: #6b7280; }
@media (max-width: 575px) {
    .tk-meta { gap: 14px; }
    .tk-cf-grid { grid-template-columns: 1fr; gap: 2px 0; }
    .tk-cf-grid dd { margin-bottom: 8px; }
}
</style>
<div class="tk-ticket">

    <!-- Ticket meta -->
