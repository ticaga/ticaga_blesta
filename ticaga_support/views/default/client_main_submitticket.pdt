<?php
    // Don't show this container when only rendering the widget section
    if (!(isset($render_section) ? $render_section : null)) {
?>
    <div class="col-md-12">
    <?php
    }
    	echo (isset($message) ? $message : null);
		// Create widget
		$this->Widget->clear();
		$this->Widget->setStyleSheet($this->view_dir . "css/styles.css");
		$title = $department_name . ': ' . $this->_('TicagaSupportPlugin.index.create_ticket', true);
		$this->WidgetClient->create($title);
		$this->WidgetClient->startBody();

		// Department closed notice (SLA business hours)
		if (!empty($business_hours) && empty($business_hours['is_open'])) {
		?>
		<style>
		.tk-closed-banner { display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px; margin-bottom: 16px; background: #fff6e6; border: 1px solid #f3d699; border-left: 4px solid #e0a106; border-radius: 8px; color: #7a5a00; }
		.tk-closed-banner strong { color: #6b4e00; }
		.tk-closed-icon { font-size: 20px; line-height: 1.3; }
		.tk-closed-msg { margin-top: 2px; font-size: 13px; color: #8a6d1f; }
		</style>
		<div class="tk-closed-banner">
			<span class="tk-closed-icon">&#9201;</span>
			<div>
				<strong><?php echo $this->_('TicagaSupportPlugin.index.dept_closed', true); ?></strong>
				<?php if (!empty($business_hours['message'])) { ?>
					<div class="tk-closed-msg"><?php echo $this->Html->safe($business_hours['message']); ?></div>
				<?php } ?>
			</div>
		</div>
		<?php
		}

		$this->Form->create(null, ['id'=>'create_ticket_ticaga', 'enctype' => 'multipart/form-data', 'class' => 'disable-on-submit']);

		if ($client_id == false)
		{
		?>
	    <div class="form-group">
    		<?php
    			$this->Form->label($this->_('TicagaSupportPlugin.index.public_name', true), "public_name");
    			$this->Form->fieldText("public_name", null, ['id' => 'public_name', 'class' => 'form-control']);
    		?>
    	</div>
    	<div class="form-group">
        	<?php
        		$this->Form->label($this->_('TicagaSupportPlugin.index.email_address', true), "email");
        	    $this->Form->fieldText("email", null, ['id' => 'email', 'class' => 'form-control']);
        	?>
        </div>
        <?php
        	}
        ?>
		<div class="form-group">
			<?php
				$this->Form->label($this->_('TicagaSupportPlugin.index.subject', true), "subject");
				$this->Form->fieldText("subject", null, ['id' => 'subject', 'class' => 'form-control']);
			?>
		</div>
		<?php if (!isset($cc_enabled) || $cc_enabled) { ?>
		<div class="form-group">
			<?php
				$this->Form->label($this->_('TicagaSupportPlugin.index.carbon_copy',true), "cc");
				$this->Form->fieldText("cc", null, ['id' => 'cc', 'class' => 'form-control', 'placeholder' => $this->_('TicagaSupportPlugin.index.carbon_copy_placeholder', true)]);
			?>
		</div>
		<?php } ?>
		<div class="form-group">
			<?php
				
				if($allow_high_priority != '3'){

					$this->Form->label($this->_('TicagaSupportPlugin.index.priority',true), "priority");
					if ($is_highpriority_allowed == true) {
						$priorities = ["low" => "Low", "medium" => "Medium", 'high' => "High", 'emergency' => 'Emergency'];
					} else {
						$priorities = ["low" => "Low","medium" => "Medium"];	
					}
				
					$this->Form->fieldSelect('priority', (isset($priorities) ? $priorities : null), null, ['id' => 'priority', 'class' => 'form-control']);
				}
			?>
		</div>
		<div class="form-group">
            <?php
                $this->Form->label($this->_('TicagaSupportPlugin.index.ticket_response',true), 'message');
                $this->Form->fieldTextarea('message', null, ['id' => 'message', 'rows' => 5, 'class' => 'form-control', 'data-markdown-editor' => '']);
            ?>
        </div>
		<?php if (!empty($show_services) && !empty($services)) { ?>
		<div class="form-group">
			<?php
				$this->Form->label(
					$this->_('TicagaSupportPlugin.index.related_service', true) . ' ' . $this->_('TicagaSupportPlugin.index.optional', true),
					"service_id"
				);
				$service_opts = ['' => $this->_('TicagaSupportPlugin.index.select_service', true)] + $services;
				$this->Form->fieldSelect('service_id', $service_opts, null, ['id' => 'service_id', 'class' => 'form-control']);
			?>
		</div>
		<?php } ?>
		<?php
			// Department custom fields (only those visible to the customer)
			require_once dirname(__FILE__) . '/custom_field_helper.php';
			$cf_defs = (isset($custom_fields) && is_array($custom_fields)) ? $custom_fields : [];
			foreach ($cf_defs as $cf) {
				if (empty($cf['visible_to_customer'])) { continue; }
				echo ticaga_render_custom_field($cf);
			}
		?>
		<button type="submit" class="btn btn-light float-right">
            <?php echo $this->_('TicagaSupportPlugin.index.create', true);?>
        </button>

    <?php
        $this->Form->end();
        $this->WidgetClient->endBody();
        $this->WidgetClient->end();
?>
