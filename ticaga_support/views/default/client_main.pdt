<?php
    // Don't show this container when only rendering the widget section
    if (!(isset($render_section) ? $render_section : null)) {
?>
    <div class="col-md-12">
    <?php
    }
        echo (isset($message) ? $message : null);
		
		if (isset($error_101) && $error_101 == true)
		{
			echo '<div style="padding: 10px; text-align: center; background-color: #d9534f; color: #f9e2e2;">';
			echo $this->_('TicagaSupportPlugin.!error.error_101',true);
			echo '</div>';
		}			

        $this->Widget->clear();
        $link_buttons = [
            ['name'=>$this->_('TicagaSupportPlugin.index.create_ticket', true), 'attributes'=>['href'=>$this->Html->safe($this->base_uri . 'plugin/ticaga_support/client_main/departments/')]]
			//['name'=>$this->_('TicagaSupportPlugin.index.sync_account', true), 'attributes'=>['href'=>$this->Html->safe($this->base_uri . 'plugin/ticaga_support/client_main/syncClientAccount/')]]
        ];
        $this->WidgetClient->setLinkButtons($link_buttons);
        $this->WidgetClient->create($this->_('TicagaSupportPlugin.index.tickets_overview', true));
	    $this->WidgetClient->startBody();
        $this->Form->create();
?>
<div class="inner">
    <div class="table-responsive">
        <table class="table table-curved table-striped">
            <thead>
                <tr class="heading_row">
                    <th><?php echo $this->_('TicagaSupportPlugin.index.ticket', true);?></th>
                    <th><?php echo $this->_('TicagaSupportPlugin.index.subject', true);?></th>
                    <th><?php echo $this->_('TicagaSupportPlugin.index.department', true);?></th>
                    <th><?php echo $this->_('TicagaSupportPlugin.index.priority', true);?></th>
                    <th><?php echo $this->_('TicagaSupportPlugin.index.status', true);?></th>
                    <th><?php echo $this->_('TicagaSupportPlugin.index.assigned', true);?></th>
                    <th class="last"></th>
                </tr>
            </thead>
            <?php
                if ($this->Html->ifSet($tickets) && $tickets != '[]')
                {
                    foreach ($tickets as $ticket) {
					if (!isset($ticket))
					{
					    break;
					} else {
                        if ($this->Html->ifSet($depts))
                        {
                            foreach ($depts["departments"] as $dept)
                            {
                                if ($ticket["department_id"] == $dept['id'])
                                {
                                    $department_name = $dept["department_name"];
                                }
                            }
                        }
            ?>
            <tbody>
                <tr>
                    <td class="align-middle"><?php echo !empty($ticket["ticket_code"]) ? $this->Html->safe($ticket["ticket_code"]) : ('#' . $this->Html->safe($ticket["id"])); ?></td>
                    <td class="align-middle"><?php echo $this->Html->safe($ticket["subject"]); ?></td>
                    <td class="align-middle"><?php echo ucwords($this->Html->safe($department_name)); ?></td>
                    <td class="align-middle"><?php echo ucwords($this->Html->safe($ticket["priority"])); ?></td>
                    <td class="align-middle"><?php echo ucwords($this->Html->safe($ticket["status"])); ?></td>
                    <td class="align-middle"><?php echo !empty($ticket["assigned_name"]) ? $this->Html->safe($ticket["assigned_name"]) : $this->_('TicagaSupportPlugin.index.unassigned', true); ?></td>
                    <td class="align-middle">
                        <a href="<?php echo $this->base_uri; ?>plugin/ticaga_support/client_main/view/<?php echo $this->Html->safe($ticket["id"]); ?>/" class="btn btn-light float-right">View</a>
                    </td>
                </tr>
            </tbody>
            <?php
                    }
				}
            } else {
            ?>
            <tr>
                <td colspan="7">
                    <div class="empty_section">
                        <div class="empty_box">
                            <div class="alert alert-info">
                                <p><?php echo $this->_('TicagaSupportPlugin.index.no_tickets', true);?></p>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
            <?php
                }
            ?>
        </table>
    </div>
</div>
